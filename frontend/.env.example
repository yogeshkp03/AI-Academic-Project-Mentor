# Vite embeds this value in the browser bundle at build time.
# Set it to the reachable backend URL for the target environment.
VITE_API_BASE_URL=http://127.0.0.1:8002

# Optional Google Form used for student mentorship appeals. Leave blank to use
# the built-in authenticated appeal form instead.
VITE_FACULTY_APPEAL_FORM_URL=
# Google Forms prefill entry IDs; retrieve each from a pre-filled link.
VITE_FORM_ENTRY_STUDENT_EMAIL=
VITE_FORM_ENTRY_FACULTY_ID=