# Copy to .env and provide at least one valid provider key.
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted as a fallback name
# for the same credential, so either one works.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional: when set, the API requires this token in the X-Agents-Token header
# for every /api/* request. The backend sends this via AI_SERVICE_API_KEY.
AGENTS_API_TOKEN=

# Optional: rate limits and cached reports are scoped per student using the
# X-Student-Id header the backend sends. Without it every caller shares the
# socket peer's budget, which for the backend means one platform-wide limit.
#
# Optional: comma-separated proxy IPs whose X-Forwarded-For header may be
# trusted. Empty by default, so a client cannot spoof its address to reset a
# rate-limit bucket.
TRUSTED_PROXIES=

# Optional overrides.
#
# Three model knobs cover every agent; individual agents can be overridden with
# MODEL_<AGENT_KEY> (MODEL_FEASIBILITY, MODEL_ARCHITECT, MODEL_SCOPE,
# MODEL_TIMELINE, MODEL_RESOURCE, MODEL_UI_UX, MODEL_PLANNING,
# MODEL_PROFESSOR). The default tiers:
#   feasibility, architect, resource -> GEMINI_MODEL (quality + tool calling;
#                                       3 Gemini calls per run instead of 6,
#                                       which is what keeps a free-tier daily
#                                       bucket alive)
#   timeline, planning               -> GROQ_MODEL (sequencing; gpt-oss-120b is
#                                       capped at 8,000 TPM on the free tier, so
#                                       only these two use it)
#   scope, ui_ux, professor          -> GROQ_LIGHT_MODEL (formatting)
# A failed run retries as a Groq-only plan, then a Gemini-only plan.
#
# Model IDs verified live 2026-09-30: groq/llama-3.3-70b-versatile and
# groq/llama-3.1-8b-instant were shut down 2026-08-16;
# gemini/gemini-2.5-flash returns 404 "no longer available to new users";
# gemini/gemini-3.8-flash answers but 503s on high demand often enough to kill
# a run at its first agent, so flash-lite (a separate per-model quota bucket)
# stays the default.
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
GROQ_MODEL=groq/openai/gpt-oss-120b
GROQ_LIGHT_MODEL=groq/openai/gpt-oss-20b
# Retries on the underlying litellm call. Kept at 1: a daily-quota 429 can never
# succeed no matter how many times it is retried, so a larger value only burns
# wall-clock before the provider fallback.
LLM_NUM_RETRIES=1
ANALYSIS_CACHE_TTL=3600
ANALYSIS_CACHE_MAX_ENTRIES=500
MAX_CONCURRENT_ANALYSES=4
# Seconds a duplicate request waits for an identical in-flight analysis before
# running its own. Keep this below ANALYSIS_DEADLINE_SECONDS.
ANALYSIS_WAIT_SECONDS=480
# Hard ceiling on one analysis request, for the case where a crew run wedges
# without any single call erroring out. One LLM call is already bounded at about
# LLM_TIMEOUT, so this only needs headroom over that
# plus overhead; it is not multiplied by the number of sequential agents,
# because a call that times out fails the whole run. Keep it below the
# backend's AGENTS_READ_TIMEOUT so the backend gets a clean 503 rather than a
# read timeout.
ANALYSIS_DEADLINE_SECONDS=540
LLM_TIMEOUT=120
CREW_MAX_RPM=10
LOG_LEVEL=INFO
CREW_VERBOSE=0
