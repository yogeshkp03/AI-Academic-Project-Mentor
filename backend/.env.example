# Use a long random value in local and deployed environments.
# The service warns on start-up if this is missing, too short, or the placeholder.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- Agents service -------------------------------------------------------
AGENTS_BASE_URL=http://127.0.0.1:8001
# Required shared secret; match AGENTS_API_TOKEN in agents/.env. Use a long,
# randomly generated value, and keep the agents service on a private network.
AI_SERVICE_API_KEY=
# Required callback secret; match BACKEND_PROGRESS_TOKEN in agents/.env.
AGENTS_PROGRESS_TOKEN=
APP_ENV=development
# Random shared secret used by the Google Apps Script form-submit trigger.
GOOGLE_FORMS_WEBHOOK_SECRET=

# Use the same database URL for the backend API and every Celery process.
DATABASE_URL=sqlite:///./academic_mentor.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For PostgreSQL use the psycopg 3 driver:
# DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/academic_mentor

# Redis broker for durable Celery analysis jobs.
REDIS_URL=redis://127.0.0.1:6379/0
