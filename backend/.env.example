# Use a long random value in local and deployed environments.
# The service warns on start-up if this is missing, too short, or the placeholder.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- Agents service -------------------------------------------------------
AGENTS_BASE_URL=http://127.0.0.1:8001
# Optional shared secret that authenticates the backend to the agents service.
# Set the same value as AGENTS_API_TOKEN in agents/.env.
# When this is set the agents service trusts the X-Student-Id header, so it must
# always be set on any deployment where the agents port is reachable directly.
AI_SERVICE_API_KEY=

# Seconds to wait for the connection to the agents service.
AGENTS_CONNECT_TIMEOUT=5
# Seconds to wait for a response. Must exceed the agents service's own worst-case
# run time (8 agents x LLM_TIMEOUT) or long analyses will be cut off mid-run.
AGENTS_READ_TIMEOUT=600
# Total attempts per agents call. Only connection errors, timeouts and 5xx are
# retried; a 4xx is returned immediately.
AGENTS_MAX_ATTEMPTS=2

# --- Reverse proxy / rate limiting ----------------------------------------
# Comma-separated proxy addresses whose X-Forwarded-For header may be trusted.
# Leave empty when the backend is exposed directly, otherwise a client can
# spoof the header and get a fresh rate-limit bucket per request.
TRUSTED_PROXIES=
# Upper bound on tracked rate-limit buckets, so rotating client identifiers
# cannot grow the in-memory dict without limit.
RATE_LIMIT_MAX_KEYS=10000

# --- CORS -----------------------------------------------------------------
# Browser origins allowed to call this API. Use explicit origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
